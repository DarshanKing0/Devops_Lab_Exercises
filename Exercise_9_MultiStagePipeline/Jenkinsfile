pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Installing dependencies...'
                dir('A9_MultiStagePipeline') {
                    sh '''
                        python3 -m venv venv
                        ./venv/bin/pip install --upgrade pip
                        ./venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                dir('A9_MultiStagePipeline') {
                    sh './venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    rm -rf "${WORKSPACE}/python-app-deploy"
                    mkdir -p "${WORKSPACE}/python-app-deploy"

                    cp "${WORKSPACE}/A9_MultiStagePipeline/app.py" \
                       "${WORKSPACE}/python-app-deploy/"

                    cp "${WORKSPACE}/A9_MultiStagePipeline/requirements.txt" \
                       "${WORKSPACE}/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running application...'
                sh '''
                    if [ -f "${WORKSPACE}/python-app-deploy/app.pid" ]; then
                        PID=$(cat "${WORKSPACE}/python-app-deploy/app.pid")
                        if kill -0 "$PID" 2>/dev/null; then
                            kill "$PID" || true
                            sleep 2
                        fi
                    fi

                    nohup "${WORKSPACE}/A9_MultiStagePipeline/venv/bin/python" \
                        "${WORKSPACE}/python-app-deploy/app.py" \
                        > "${WORKSPACE}/python-app-deploy/app.log" 2>&1 &

                    echo $! > "${WORKSPACE}/python-app-deploy/app.pid"
                    sleep 3
                    cat "${WORKSPACE}/python-app-deploy/app.log"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed application...'
                sh '''
                    "${WORKSPACE}/A9_MultiStagePipeline/venv/bin/python" - <<'PY'
import urllib.request

url = "http://127.0.0.1:5000/"
response = urllib.request.urlopen(url)
body = response.read().decode()

print("HTTP Status:", response.status)
print("Response:", body)

assert response.status == 200
assert body == "Hello, Jenkins Multi-Stage Pipeline!"

print("Application test passed!")
PY
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
